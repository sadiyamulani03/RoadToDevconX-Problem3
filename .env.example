# Local development example only. Do not put a funded private key here.
# The client reads these variables only when the corresponding CLI option is omitted.
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ACCOUNT=0x0000000000000000000000000000000000000000

# Leave empty. Prefer --private-key-file with a mode-600 file, or an ephemeral
# environment variable that is not persisted to disk.
PRIVATE_KEY=
